{
  "name": "pi-project-manager",
  "version": "0.2.0",
  "description": "Pi extension: Raycast/Telescope-style modern two-pane project manager with instant search, live Git/session preview, and scratchpad mode",
  "type": "module",
  "author": "jiangkoumo",
  "license": "MIT",
  "homepage": "https://github.com/jiangkoumo/pi-project-manager#readme",
  "bugs": {
    "url": "https://github.com/jiangkoumo/pi-project-manager/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiangkoumo/pi-project-manager.git"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "project",
    "workspace",
    "session",
    "scratchpad",
    "codex"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/jiangkoumo/pi-project-manager/main/assets/preview.png"
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npx tsx test/render-test.ts && npx tsx test/width-test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84",
    "@earendil-works/pi-tui": ">=0.84"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
